# Public backend origin. Do not include /api/v1 or a trailing slash.
NEXT_PUBLIC_API_URL=https://arima-executive-os-production.up.railway.app
NEXT_PUBLIC_ARIMA_CSRF_COOKIE_NAME=arima_csrf_token

# Keep false in deployed environments to use the live API.
NEXT_PUBLIC_ARIMA_DEMO_MODE=false
NEXT_PUBLIC_ARIMA_VOICE_ENABLED=true
